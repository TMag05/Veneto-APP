rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /fotos/{dia}/{autorId}/{ficheiro} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == autorId);
      allow delete: if request.auth != null && (request.auth.uid == autorId);
    }
  }
}
