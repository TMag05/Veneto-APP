rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    // O email da sessão está na equipa, e a pessoa provou que é dela:
    // tocou no link que o Firebase lhe mandou. Sem isto, quem soubesse
    // um email da equipa ainda sem acesso podia criá-lo (29.09.2026).
    function naEquipa() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/equipa/$(request.auth.token.email));
    }

    // Organização é quem tem o papel no perfil e o email na equipa,
    // as duas coisas: retirar o email da equipa tira logo os poderes,
    // mesmo que o perfil fique para trás (29.09.2026).
    function isOrganizacao() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/contas/$(request.auth.uid)).data.papel == 'organizacao'
        && naEquipa();
    }

    // O papel que uma conta pode ter: convidado, ou organização só
    // se o email da sessão estiver na equipa.
    function papelValido(papel) {
      return papel == 'convidado' || (papel == 'organizacao' && naEquipa());
    }

    // Contas de utilizadores e perfis. Quem é dono muda o nome, o
    // carro e o lugar; o papel só passa a organização com o email na
    // equipa — quem foi convidado antes de entrar para a equipa, ou
    // saiu e voltou, entra pela porta da organização (29.09.2026).
    match /contas/{uid} {
      allow read: if isOwner(uid) || isOrganizacao();
      allow create: if isOwner(uid)
        && papelValido(request.resource.data.get('papel', 'convidado'));
      allow update: if isOwner(uid)
        && (request.resource.data.get('papel', 'convidado') == resource.data.get('papel', 'convidado')
            || papelValido(request.resource.data.get('papel', 'convidado')));
      allow delete: if isOrganizacao();
    }

    // O cartão público de cada convidado, para a lista de quem vai:
    // só o nome, o carro e o lugar no carro. Lê quem tem sessão;
    // escreve só o próprio; apaga o próprio ou a organização.
    match /participantes/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nome', 'modelo', 'funcao', 'atualizado'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80;
      allow delete: if isOwner(uid) || isOrganizacao();
    }

    // Os emails que podem ter acesso de organização. Pergunta-se por
    // um de cada vez sem sessão — a porta precisa de o saber antes de
    // criar a conta —; a lista inteira, só a equipa a lê.
    match /equipa/{email} {
      allow get: if true;
      allow list, write: if isOrganizacao();
    }

    // Conteúdo / Edições do evento
    match /edicoes/{edicao} {
      allow read: if true;
      allow write: if isOrganizacao();
    }

    // Fotografias partilhadas do grupo
    match /fotos/{fotoId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.autorId == request.auth.uid || isOrganizacao()
      );
    }

    // Chegadas das equipas
    match /chegadas/{id} {
      allow read: if isOrganizacao();
      allow create: if isAuthenticated();
    }

    // Pedidos ao concierge
    match /pedidos/{id} {
      allow read: if isOwner(resource.data.autorId) || isOrganizacao();
      allow create: if isAuthenticated();
      allow update: if isOrganizacao();
    }
  }
}
